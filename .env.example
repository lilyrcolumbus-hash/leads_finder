# HubSpot CRM API Key
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Google Custom Search API
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# OpenAI API Key (for AI filtering - paid)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key (alternative to OpenAI - paid)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Local AI (free - requires Ollama installed locally)
# Install: https://ollama.com/download
# Then run: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Google Gemini AI (free tier - 15 requests/min)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

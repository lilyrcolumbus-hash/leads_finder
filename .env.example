# =============================================================
# GOOGLE CLOUD
# =============================================================

# Google Places API Key (for Google Maps scraper)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Google Apps Script Deployment (alternative to Python scraper)
# Searches businesses and writes directly to Sheet via HTTP
APPS_SCRIPT_DEPLOYMENT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_DEPLOYMENT_ID=YOUR_DEPLOYMENT_ID

# Google Sheets - Service Account
GOOGLE_SHEETS_SHARE_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google_sheets_sa.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Custom Search API
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# =============================================================
# CRM & AI
# =============================================================

# HubSpot CRM API Key
HUBSPOT_API_KEY=your_hubspot_api_key_here

# AI Filtering (OpenAI primary, Anthropic fallback, Gemini optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================
# ENRICHMENT
# =============================================================

# Hunter.io API Key (for email lookup)
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io API Key
APOLLO_API_KEY=your_apollo_api_key_here

# Facebook Access Token
FACEBOOK_ACCESS_TOKEN=your_facebook_token_here
